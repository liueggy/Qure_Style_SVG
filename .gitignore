# Only the standalone icon repository is published from this workspace.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES.md
!/icon/
!/docs/
!/Other/
!/licenses/

/icon/*
!/icon/svg/
/icon/svg/*
!/icon/svg/common/
!/icon/svg/flag/
/icon/svg/common/*
!/icon/svg/common/*.svg
!/icon/svg/common/README.md
/icon/svg/flag/*
!/icon/svg/flag/*.svg
!/icon/svg/flag/README.md

# 144px PNG exports (for clients that do not support SVG icons)
!/png/
/png/*
!/png/common/
!/png/flag/
!/png/common/*.png
!/png/flag/*.png

/docs/*
!/docs/assets/
/docs/assets/*
!/docs/assets/*-overview.svg
!/docs/assets/*-overview.png
/Other/*
!/Other/Qure-Style-SVG.json
__pycache__/

# local helpers (not tracked)
browse.html
surge-icon-url.txt
